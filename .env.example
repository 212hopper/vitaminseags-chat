# Twitch application from https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Channel to overlay (login name, without https://twitch.tv/)
TWITCH_CHANNEL=

# Public URL of this app (no trailing slash).
# Local: http://127.0.0.1:30009
# Server: http://YOUR_LAN_IP:30009  or  https://chat.example.com
PUBLIC_BASE_URL=http://127.0.0.1:30009

# Must match a Redirect URL on the Twitch application.
# Defaults to ${PUBLIC_BASE_URL}/oauth/callback if unset.
TWITCH_REDIRECT_URI=http://127.0.0.1:30009/oauth/callback

# Bind address inside the process. Docker/Portainer should keep 0.0.0.0
HOST=0.0.0.0
PORT=30009

# Overlay (all optional; these are the defaults)
# HOLD = how long a message stays fully visible
# FADE = how long it takes to fade out after hold
OVERLAY_MAX_MESSAGES=14
OVERLAY_HOLD_MS=25000
OVERLAY_FADE_MS=600
OVERLAY_HIDE_COMMANDS=true

# App login (not Twitch). If both are set, dashboard/stats/home require sign-in.
# The OBS overlay at /overlays/chat/ stays public.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional first-run seed if you already have tokens. Prefer authorizing at /oauth.
# TWITCH_ACCESS_TOKEN=
# TWITCH_REFRESH_TOKEN=
